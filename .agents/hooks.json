{
  "spec-edit-guard": {
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file|replace_file_content|multi_replace_file_content|write_to_file|delete_file",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/guard_spec_edit.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

