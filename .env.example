# ==========================================
# DayT Local Environment Variables Template
# 사용법: 이 파일을 `.env`로 복사한 뒤 실제 API 키를 채워 사용하세요.
#   PowerShell : Copy-Item .env.example .env
#   Bash / Zsh : cp .env.example .env
# ==========================================

# ------------------------------------------
# 1. Local Infrastructure (Docker Compose)
# ------------------------------------------
POSTGRES_DB=dayt
POSTGRES_USER=dayt
POSTGRES_PASSWORD=dayt1234
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------
# 2. Main Backend (`backend/` - Spring Boot)
# ------------------------------------------
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/dayt
SPRING_DATASOURCE_USERNAME=dayt
SPRING_DATASOURCE_PASSWORD=dayt1234

# 최소 32자 이상의 랜덤 문자열 사용
JWT_SECRET=dayt-local-dev-jwt-secret-key-change-in-production-2026

# OAuth2 (Kakao / Google) & Kakao Local/Mobility API
KAKAO_CLIENT_ID=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret
KAKAO_REST_API_KEY=your_kakao_rest_api_key
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Internal AI Service 연동
AI_SERVICE_BASE_URL=http://localhost:8000

# ------------------------------------------
# 3. AI & Data Service (`ai-service/` - FastAPI)
# ------------------------------------------
AI_SERVER_PORT=8000
DATABASE_URL=postgresql+psycopg://dayt:dayt1234@localhost:5432/dayt

# LLM & 외부 수집 API
GEMINI_API_KEY=your_gemini_api_key
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
TOUR_API_SERVICE_KEY=your_tour_api_or_data_go_kr_key
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# ------------------------------------------
# 4. Clients (`mobile/` Expo & `web/` Next.js)
# ------------------------------------------
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
EXPO_PUBLIC_WS_URL=ws://localhost:8080/ws/collab
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_sdk_key

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_js_api_key

